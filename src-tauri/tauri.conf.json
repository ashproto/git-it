{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git It",
  "version": "0.1.0",
  "identifier": "com.ashshah.gittimeeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Git It",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["popover", "acrylic"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Batch-edit git commit timestamps",
    "longDescription": "A desktop GUI for rewriting git commit timestamps using git-filter-repo. Supports offset, exact-time, and proportional compression of commit dates, with bundle backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3"
    }
  }
}
