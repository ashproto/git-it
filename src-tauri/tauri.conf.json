{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git It",
  "version": "0.1.0",
  "identifier": "com.ashshah.gitit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Git It",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["popover", "acrylic"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "A native macOS git client with first-class commit-time editing",
    "longDescription": "Git It is a fast, native macOS git client built with Tauri and Svelte: a commit graph, branch and tag operations, merge/cherry-pick/revert with conflict resolution, reset/amend/rebase/interactive-rebase with one-click undo, a working-copy diff/stage/commit/stash workflow, and remote pull/push — plus the commit-timestamp editing it grew from.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.3",
      "providerShortName": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ashproto/git-it/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQUY4QTA0NUU0RjkzRQpSV1ErK2VSRm9QZ0tBL2FWdTAxWFVFc2h5YmM0dEpDb3FVSzZEZ0Nqb25GZ2JPQmdwZ2JGZDRTRgo="
    }
  }
}
